# ==== ADMIN PANEL ====
# Lozinka za /admin/login (min 6 znakova). NIKAD ne ide u kod/git.
ADMIN_PASSWORD=promijeni-me-odmah

# Tajni ključ za potpisivanje session cookieja (min 16 znakova).
# Generiši: openssl rand -base64 32
ADMIN_SESSION_SECRET=promijeni-ovaj-dugi-tajni-kljuc

# ==== SUPABASE: BAZA ====
# Supabase -> Connect -> Connection pooling -> Transaction mode (port 6543).
# Obavezno POOLER (6543), ne direktna konekcija (5432) — Vercel pravi
# mnogo kratkih konekcija i direktna bi se brzo zagušila.
DATABASE_URL=postgresql://postgres.xxxxxxxx:LOZINKA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ==== SUPABASE: STORAGE (slike/videi) ====
# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role ključ (tajni, SAMO server). Ne stavljati NEXT_PUBLIC_ prefiks!
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Naziv public bucketa za uploade (default: media)
SUPABASE_BUCKET=media
