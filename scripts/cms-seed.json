  "reviews": [
    {
      "id": "rev_01bbc3a67b4f4f1b",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Dženita M.",
      "inicijal": "D",
      "rating": 5,
      "tekst": "Nikad ne pišem recenzije, ali ovo me stvarno oduševilo. Iskreno, bila sam skeptična, ali ih je TAKO LAKO staviti, a izdržale su cijeli rođendan u trampoline parku! Nakon toga je čak i spavala s njima, a ujutro su još uvijek sve bile na mjestu!!! Nemam pojma kako, jer uopšte nisu pretjerano ljepljive. Jutros sam ih skinula bez ikakvih problema, bez bola, suza ili čupanja kose. Stvarno ne znam koja je nauka iza ovoga? 😂 Ozbiljno preporučujem!",
      "verified": 1,
      "slika": "/img/blinger/recenzije/rodjendan.jpg",
      "datum": "",
      "status": "published",
      "sort_order": 2,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_8ce265ec87424064",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Amila K.",
      "inicijal": "A",
      "rating": 5,
      "tekst": "Iskreno nisam znala šta da očekujem kada sam naručila, ali baš sam zadovoljna. Vrlo jednostavno se stavljaju, lijepo stoje u kosi i najvažnije mi je što se poslije bez problema skinu.",
      "verified": 1,
      "slika": "",
      "datum": "",
      "status": "published",
      "sort_order": 3,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_76ba0ad585084711",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Merima S.",
      "inicijal": "M",
      "rating": 5,
      "tekst": "Kupila sam ih za kćerku jer stalno traži neke ukrase za kosu. Mislila sam da će brzo spasti, ali držale su joj skoro cijeli dan. Baš su praktične, lako ih mogu staviti i sama kod kuće.",
      "verified": 1,
      "slika": "",
      "datum": "",
      "status": "published",
      "sort_order": 6,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_ed7371d4b5fa4806",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Lejla P.",
      "inicijal": "L",
      "rating": 5,
      "tekst": "Najviše sam se bojala skidanja jer moja curica ne podnosi kada je nešto vuče za kosu. Na kraju nije bilo nikakvih problema. Jednostavno se stave, lijepo izgledaju i lako se skinu.",
      "verified": 1,
      "slika": "",
      "datum": "",
      "status": "published",
      "sort_order": 9,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_7c0306fcc3ab4545",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Emina R.",
      "inicijal": "E",
      "rating": 5,
      "tekst": "Naručila sam ih više iz radoznalosti, ali moram priznati da su me pozitivno iznenadile. Kćerka ih baš voli, a meni odgovara što ne moram dugo praviti frizuru da bi kosa izgledala zanimljivije.",
      "verified": 1,
      "slika": "",
      "datum": "",
      "status": "published",
      "sort_order": 10,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_61646b3b656248c6",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Amra B.",
      "inicijal": "A",
      "rating": 5,
      "tekst": "Baš dobra stvar za djevojčice koje vole šljokice i ukrase u kosi. Kod nas se pokazalo super za rođendane i posebne prilike, ali ih sada želi nositi i običnim danima.",
      "verified": 1,
      "slika": "",
      "datum": "",
      "status": "published",
      "sort_order": 11,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_d27815b0c03f4dda",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Ajla N.",
      "inicijal": "A",
      "rating": 5,
      "tekst": "Prvi put sam mislila da neću znati kako ih pravilno staviti, ali stvarno je jednostavno. Trebalo mi je svega nekoliko minuta, a frizura je odmah izgledala mnogo ljepše.",
      "verified": 1,
      "slika": "",
      "datum": "",
      "status": "published",
      "sort_order": 12,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_f6d2209fd25e4c97",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Belma T.",
      "inicijal": "B",
      "rating": 5,
      "tekst": "Ono što mi se posebno svidjelo jeste što nisu neugodne na kosi. Kćerka ih je nosila nekoliko sati i nije se žalila da je nešto zateže ili smeta. Skinule smo ih brzo i bez ikakve drame.",
      "verified": 1,
      "slika": "",
      "datum": "",
      "status": "published",
      "sort_order": 13,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_b38efc7a92004290",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Vildana H.",
      "inicijal": "V",
      "rating": 5,
      "tekst": "Stvarno praktično kada nemate vremena za neku posebnu frizuru. Stavili smo ih pred izlazak i kosa je odmah izgledala sređenije. Za djevojčice koje vole ovakve detalje baš lijepa stvar.",
      "verified": 1,
      "slika": "",
      "datum": "",
      "status": "published",
      "sort_order": 14,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_7ff3a9b3c73f4b62",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Adna F.",
      "inicijal": "A",
      "rating": 5,
      "tekst": "Koristile smo ih već nekoliko puta i svaki put su se dobro pokazale. Najvažnije mi je bilo da neće čupati kosu prilikom skidanja, a toga stvarno nije bilo. Kćerka je zadovoljna, a samim tim i ja.",
      "verified": 1,
      "slika": "",
      "datum": "",
      "status": "published",
      "sort_order": 15,
      "created_at": "2026-09-14T08:25:23.141Z",
      "deleted_at": null
    },
    {
      "id": "rev_0022db9ae5ae4991",
      "product_id": "prod_7c3bfb6823e24d77",
      "ime": "Jasmina D.",
      "inicijal": "J",
      "rating": 5,
      "tekst": "Mislila sam da će nakon igre i trčanja sve odmah spasti, ali ostale su dosta dugo u kosi. Za mene je najveći plus što se kasnije bez problema skinu i ne ostavljaju kosu zamršenu.",
      "verified": 1,
